{
  "$schema": "https://opencode.ai/config.json",

  // IMPORTANT: Plan mode has `edit: deny` baked into its permission ruleset.
  // If a file write is denied with a permission error, check if we're in plan
  // mode. Ask the user to switch to build mode before attempting writes.
  // Plan mode is read-only by design — use it for exploration and planning,
  // then switch to build mode for actual code changes.

  // Default model — ollama-cloud/minimax-m3 (the user's standing preference).
  // To switch per-session, use `opencode run --model <provider>/<id>` or the
  // TUI's `/model` command. Other handy options:
  //   opencode/big-pickle             — fast/free opencode-hosted alternative
  //   ollama-cloud/gemma4:31b         — wallet-friendly 31B
  //   opencode/minimax-m3-free        — free mini-max hosted variant
  "model": "ollama-cloud/minimax-m3",

  // Enable LSP servers for code intelligence
  "lsp": {
    "clangd": {
      "command": ["clangd-22", "--clang-tidy", "--query-driver=/opt/intel/oneapi/compiler/2026.0/bin/dpcpp", "--compile-commands-dir=/home/mirai/vendor/llama.cpp/build"],
      "extensions": [".c", ".cpp", ".cc", ".cxx", ".c++", ".h", ".hpp", ".hh", ".hxx", ".h++", ".sycl"]
    }
  },

  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git"],

  // Permissions for the mechanic role.
  // opencode runs as a trusted technician on Mirai's host — it should not
  // have to prompt for reads inside the user's own config, the opencode
  // skills/state dirs, or system paths needed to diagnose and repair.
  // Writes are still prompted (the user can override per-tool via flags
  // or "auto-accept all" once trust is established).
  "permission": {
    "edit":     "allow",
    "webfetch": "allow",
    "bash": {
      "*":                     "allow",
      "rm":                    "allow",
      "sudo":                  "allow",
      "sudo *":                "allow",
      "systemctl *":           "allow",
      "pkill":                 "deny",
      "pkill *":               "deny",
      "kill -9 *":             "deny",
      "killall":               "deny"
    },
    "read": {
      "*": "allow"
    },
    "external_directory": "allow"
  }
}
